DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=1200
# Each staged MCP step makes one LLM request and returns before the client timeout.
KB_MCP_LLM_STEP_TIMEOUT_SECONDS=35

# Optional real embedding provider. Keep API keys out of Git.
KB_EMBEDDING_PROVIDER=hash
# KB_EMBEDDING_PROVIDER=openai-compatible
# KB_EMBEDDING_BASE_URL=http://your-openai-compatible-gateway/v1
# KB_EMBEDDING_API_KEY=sk-your-key-here
# KB_EMBEDDING_MODEL=bge-m3
# KB_EMBEDDING_TIMEOUT_SECONDS=45
